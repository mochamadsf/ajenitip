# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
# NOTE: .env.local is gitignored and never committed. For Vercel deployment,
# add these variables in Vercel Dashboard -> Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
